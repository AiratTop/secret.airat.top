{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-airat",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": { "enabled": true },

  "vars": {
    "SITE_HOST": "secret.airat.top"
  },

  // The static UI lives in `public_html`, but the Worker has to see the request first:
  // `/{id}` is an id-shaped path, not a file, and the asset server would answer 404 for it
  // before any route matched. `run_worker_first` inverts that, and the Worker falls through
  // to `env.ASSETS` for everything it does not itself claim.
  // `html_handling: "none"` turns off the asset server's .html rewriting. By default
  // `/view.html` answers with a 307 to `/view`, which is a redirect in the middle of
  // serving a secret's page for no benefit here — the Worker decides which file every
  // path maps to, and it should get the file it asked for.
  "assets": {
    "directory": "./public_html",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-airat",
      "database_id": "3c81e9ea-41a6-45e6-9d56-32608414b77f",
      "migrations_dir": "migrations"
    }
  ],

  /*
   * Flood protection. A single D1 serialises its queries and has a hard size ceiling, so
   * an unauthenticated POST that writes up to 64 KB for up to thirty days is the one
   * endpoint that can take the service down without any cleverness — fill the database,
   * spend the write allowance, and queue behind every real request.
   *
   * A Durable Object rather than Cloudflare's rate limit binding, which is the documented
   * answer and was tried first: on this account it never refused anything, allowing fifty
   * consecutive requests against a limit of one a minute. See src/rate-limiter.js.
   *
   * One object per caller means the limit is exact rather than per data centre, which is
   * what the binding trades away — and here the number being real is the point.
   */
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],

  // Expiry is enforced on read as well, so a secret is never served past its deadline even
  // if this never fires. The cron is what stops expired rows accumulating in D1.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }

  // No `routes` block, matching every other project in this workspace: the custom domain
  // is attached once in the Cloudflare dashboard rather than declared here. Declaring it
  // would make each deploy call the zone API, so the CI token would need
  // `Zone -> Workers Routes -> Edit` on airat.top — which is DNS-adjacent write access
  // handed to a token that lives in GitHub. For this project in particular that is a bad
  // trade: a leaked token should not be able to repoint the domain people send secrets to.
}
